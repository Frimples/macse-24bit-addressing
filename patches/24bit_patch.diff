     if (CHKVAR("iscsi") && !iscsi_enabled) {
         printf("[MAC68K] iSCSI Interface Enabled... well, not really.\n");
         iscsi_enabled = 1;
diff --git a/platforms/macse/default.cfg b/platforms/macse/default.cfg
index 1117277..d1b7ebe 100644
--- a/platforms/macse/default.cfg
+++ b/platforms/macse/default.cfg
@@ -2,6 +2,13 @@
 # Sets CPU type. Valid types are (probably) 68000, 68010, 68020, 68EC020, 68030, 68EC030, 68040, 68EC040, 68LC040 and some STTTT thing.
 #cpu STTTT
 cpu 68000 
+
+# force24bit: Macintosh SE 24-bit addressing override (see 24bit_patch.diff).
+# When 1 (default), the emulated address mask is clamped to 0x00FFFFFF for EVERY
+# CPU type, so 68020/68030-class cores present a 24-bit address bus and become
+# usable on the SE (which relies on 24-bit addressing). Set 0 to restore normal
+# 32-bit addressing for the 020/030.
+#force24bit 1
 #cpu 68010
 #cpu 68EC020
 # Map 512KB kickstart ROM to default offset.
